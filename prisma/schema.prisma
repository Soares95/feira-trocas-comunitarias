generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model items {
  id                                       String      @id
  name                                     String
  description                              String
  category                                 String
  imageUrl                                 String?
  ownerId                                  String
  users                                    users       @relation(fields: [ownerId], references: [id])
  proposals_proposals_desiredItemIdToitems proposals[] @relation("proposals_desiredItemIdToitems")
  proposals_proposals_itemOfferedIdToitems proposals[] @relation("proposals_itemOfferedIdToitems")
}

model proposals {
  id                                   Int      @id @default(autoincrement())
  itemOfferedId                        String
  desiredItemId                        String
  proponentId                          String
  status                               status   @default(PENDING)
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime
  items_proposals_desiredItemIdToitems items    @relation("proposals_desiredItemIdToitems", fields: [desiredItemId], references: [id])
  items_proposals_itemOfferedIdToitems items    @relation("proposals_itemOfferedIdToitems", fields: [itemOfferedId], references: [id])
  users                                users    @relation(fields: [proponentId], references: [id])
}

model users {
  id        String      @id
  name      String
  email     String      @unique
  password  String
  items     items[]
  proposals proposals[]
}

model usuarios {
  id           Int       @id @default(autoincrement())
  nome         String
  email        String    @unique
  senhahash    String
  datacadastro DateTime? @default(now()) @db.Timestamp(6)
}

enum status {
  PENDING
  ACCEPTED
  REFUSED
}
